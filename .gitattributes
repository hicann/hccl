# 默认所有文本文件使用 LF，防止 Windows autocrlf 转换为 CRLF
* text=auto eol=lf

# LFS 跟踪的图片（二进制，不转换换行）
*.png filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
